# StyleAura Fashion Store - OAuth Environment Variables

# Google OAuth Configuration
# Get your Client ID from Google Cloud Console (https://console.cloud.google.com/)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Facebook OAuth Configuration
# Get your App ID from Meta for Developers (https://developers.facebook.com/)
VITE_FACEBOOK_APP_ID=your_facebook_app_id

# Apple OAuth Configuration
# Get your Service ID from Apple Developer Center (https://developer.apple.com/)
VITE_APPLE_CLIENT_ID=com.styleaura.app
